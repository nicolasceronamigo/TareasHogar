<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetalleActivity"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        >

        <ImageView
            android:id="@+id/imgBarrer"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/escoba"
            android:contentDescription="@string/descripcion_barrer"
            />

        <TextView
            android:id="@+id/txtTareaBarrer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/txt_barrer_patio"
            android:textSize="26sp"
            android:textStyle="bold"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            >
            <TextView
                android:id="@+id/txtVecesRealizada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:gravity="center_horizontal"
                android:text="@string/txt_veces_realizada"
                />
            <TextView
                android:id="@+id/txtNumeroRealizada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:gravity="center_horizontal"
                android:text="@string/txt_num_realizada"
                android:textStyle="bold"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            >
            <TextView
                android:id="@+id/txtUltimaRealizada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:gravity="center_horizontal"
                android:text="@string/txt_ultima_realizada"
                />
            <TextView
                android:id="@+id/txtFechaUltimaRealizada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:gravity="center_horizontal"
                android:text="@string/txt_fecha_ultima_realizada"
                android:textStyle="bold"
                />
        </LinearLayout>


        <Switch
            android:id="@+id/swRealizada"
            android:layout_width="wrap_content"
            android:minWidth="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="false"
            android:minHeight="48dp"
            android:text="@string/sw_realizada"
            tools:ignore="UseSwitchCompatOrMaterialXml"
            />

        <Button
            android:id="@+id/btnEditar"
            android:layout_width="wrap_content"
            android:minWidth="150dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_editar"
            android:backgroundTint="@color/yellow"
            android:textColor="@color/black"
            />

        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="wrap_content"
            android:minWidth="150dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btn_eliminar"
            android:backgroundTint="@color/red"
            android:textColor="@color/black"
            />
    </LinearLayout>
</ScrollView>