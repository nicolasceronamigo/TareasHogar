<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pantallaAgregar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".AgregarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- TITULO -->
        <TextView
            android:id="@+id/txtTituloAgregar"
            style="@style/Widget.TareasHogar.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/agregar_titulo" />

        <!-- SUBTITULO -->
        <TextView
            android:id="@+id/txtSubtituloAgregar"
            style="@style/Widget.TareasHogar.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/agregar_subtitulo" />

        <!-- ZONA -->
        <TextView
            android:id="@+id/txtZona"
            style="@style/Widget.TareasHogar.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/agregar_zona" />

        <Spinner
            android:id="@+id/spnZona"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:entries="@array/zonas_hogar"
            android:spinnerMode="dropdown" />

        <EditText
            android:id="@+id/edtNuevaZona"
            style="@style/Widget.TareasHogar.Campo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/agregar_nueva_zona_hint"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <!-- CATEGORIA -->
        <TextView
            android:id="@+id/txtCategoria"
            style="@style/Widget.TareasHogar.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/agregar_categoria" />

        <Spinner
            android:id="@+id/spnCategoria"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:entries="@array/categorias_tarea"
            android:spinnerMode="dropdown" />

        <!-- TAREA -->
        <TextView
            android:id="@+id/txtTareaEspecifica"
            style="@style/Widget.TareasHogar.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/agregar_tarea_especifica" />

        <Spinner
            android:id="@+id/spnTarea"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:entries="@array/tareas_sugeridas"
            android:spinnerMode="dropdown" />

        <EditText
            android:id="@+id/edtTareaPersonalizada"
            style="@style/Widget.TareasHogar.Campo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/agregar_tarea_personalizada_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences" />

        <!-- FRECUENCIA -->
        <TextView
            android:id="@+id/txtFrecuencia"
            style="@style/Widget.TareasHogar.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/agregar_frecuencia" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/edtFrecuenciaCantidad"
                style="@style/Widget.TareasHogar.Campo"
                android:layout_width="80dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:hint="@string/agregar_frecuencia_hint"
                android:importantForAutofill="no"
                android:inputType="number" />

            <Spinner
                android:id="@+id/spnUnidadFrecuencia"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:entries="@array/unidades_frecuencia"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <!-- RESPONSABLE -->
        <TextView
            android:id="@+id/txtResponsable"
            style="@style/Widget.TareasHogar.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/agregar_responsable" />

        <Spinner
            android:id="@+id/spnResponsable"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:entries="@array/responsables"
            android:spinnerMode="dropdown" />

        <!-- RECORDATORIO -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swRecordatorio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="52dp"
            android:text="@string/agregar_recordatorio"
            android:textColor="?attr/colorOnSurface" />

        <!-- PRIORIDAD -->
        <TextView
            android:id="@+id/txtPrioridad"
            style="@style/Widget.TareasHogar.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/agregar_prioridad" />

        <RadioGroup
            android:id="@+id/rgPrioridad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPrioridadBaja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/prioridad_baja" />

            <RadioButton
                android:id="@+id/rbPrioridadMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/prioridad_media" />

            <RadioButton
                android:id="@+id/rbPrioridadAlta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/prioridad_alta" />

        </RadioGroup>

        <!-- GUARDAR -->
        <Button
            android:id="@+id/btnGuardarTarea"
            style="@style/Widget.TareasHogar.Boton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/agregar_boton" />

        <!-- CANCELAR -->
        <TextView
            android:id="@+id/txtCancelarAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/agregar_cancelar"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
