<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pantallaIA"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".IAActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- TITULO -->
        <TextView
            android:id="@+id/txtTituloIA"
            style="@style/Widget.TareasHogar.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ia_titulo" />

        <!-- SUBTITULO -->
        <TextView
            android:id="@+id/txtSubtituloIA"
            style="@style/Widget.TareasHogar.Subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ia_subtitulo" />

        <!-- PREGUNTA -->
        <TextView
            android:id="@+id/txtPreguntaLabelIA"
            style="@style/Widget.TareasHogar.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/ia_pregunta_label" />

        <!-- CAMPO DE CONSULTA -->
        <EditText
            android:id="@+id/edtPreguntaIA"
            style="@style/Widget.TareasHogar.Campo"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp"
            android:gravity="top|start"
            android:padding="12dp"
            android:hint="@string/ia_pregunta_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minLines="3" />

        <!-- BOTON PREGUNTAR -->
        <Button
            android:id="@+id/btnPreguntarIA"
            style="@style/Widget.TareasHogar.Boton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/ia_boton" />

        <!-- TITULO RESPUESTA -->
        <TextView
            android:id="@+id/txtRespuestaTituloIA"
            style="@style/Widget.TareasHogar.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/ia_respuesta_titulo"
            android:textSize="18sp" />

        <!-- AREA DE RESPUESTA -->
        <TextView
            android:id="@+id/txtRespuestaIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="150dp"
            android:padding="16dp"
            android:background="@drawable/bg_tarjeta"
            android:gravity="top|start"
            android:lineSpacingExtra="4dp"
            android:text="@string/ia_respuesta_ejemplo"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
